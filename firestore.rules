rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isO51WAdmin() {
      return request.auth != null
        && request.auth.token.email == 'waao51w@gmail.com';
    }

    // Public site content is readable by visitors; only the admin can write.
    match /site/{documentId} {
      allow read: if true;
      allow write: if isO51WAdmin();
    }

    // Project progress and project records are public to read; admin-managed.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isO51WAdmin();
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
